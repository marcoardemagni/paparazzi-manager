# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # numero sandbox Twilio

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Admin — incolla qui il JSON del service account su una sola riga
# (in Railway: usa il pannello Variables, non questo file)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"paparazzi-manager",...}

# URL pubblico di questo server (usato per validare firma Twilio in produzione)
WEBHOOK_URL=https://tuo-progetto.up.railway.app/webhook

# Ambiente
NODE_ENV=production
PORT=3000
